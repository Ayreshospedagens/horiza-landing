---
import { Image } from 'astro:assets';
import desktop from '../assets/prints/fluxo-desktop.png';
import celular from '../assets/prints/fluxo-celular.png';
import { site } from '../content/site';
const { hero: h, links } = site;
---
<section id="topo" class="hero">
  <div class="container grade">
    <div class="texto">
      <h1 class="h1">{h.titulo}</h1>
      <p class="lead apoio">{h.apoio}</p>
      <div class="acoes">
        <a class="btn btn-primario" href={links.cadastro} data-utm data-track="cta_teste_click" data-local="hero">{h.ctaTeste}</a>
        <a class="btn btn-contorno" href="#demonstracao">{h.ctaDemo}</a>
      </div>
      <ul class="selos">{h.selos.map((s) => <li>{s}</li>)}</ul>
    </div>
    <div class="telas" aria-hidden="false">
      <Image src={desktop} alt="Fluxo de caixa do Horiza no computador, com o saldo previsto dos próximos meses" class="tela-desktop" widths={[640, 960, 1280]} sizes="(min-width: 900px) 620px, 0px" loading="eager" fetchpriority="high" />
      <Image src={celular} alt="Fluxo de caixa do Horiza no celular" class="tela-celular" widths={[260, 390, 520]} sizes="(min-width: 900px) 200px, 62vw" loading="eager" />
    </div>
  </div>
  <span class="faixa" aria-hidden="true"></span>
</section>

<style>
  .hero { position: relative; background: var(--grafite); color: var(--offwhite); padding: 104px 0 56px; overflow: hidden; }
  .grade { display: grid; gap: 40px; position: relative; z-index: 1; }
  .h1 { color: var(--offwhite); }
  .apoio { margin-top: 18px; color: #C9CBD0; max-width: 560px; }
  .acoes { display: grid; gap: 10px; margin-top: 28px; }
  .acoes .btn-contorno { color: var(--offwhite); }
  .selos { list-style: none; padding: 0; margin-top: 18px; display: flex; flex-wrap: wrap; gap: 6px 16px; font-size: 14px; font-weight: 600; color: #C9CBD0; }
  .selos li::before { content: '✓ '; color: var(--laranja); font-weight: 800; }
  .telas { position: relative; display: flex; justify-content: center; }
  .telas :global(.tela-desktop) { display: none; }
  .telas :global(.tela-celular) { width: min(62vw, 280px); border-radius: 28px; border: 6px solid var(--grafite-2); box-shadow: 0 30px 60px rgba(0,0,0,.45); max-height: 520px; object-fit: cover; object-position: top; }
  .faixa { position: absolute; left: -10%; right: -10%; bottom: 18%; height: 120px; background: var(--laranja); transform: skewY(-12deg); opacity: .9; }
  @media (min-width: 600px) { .acoes { grid-template-columns: auto auto; justify-content: start; } }
  @media (min-width: 900px) {
    .hero { padding: 140px 0 96px; }
    .grade { grid-template-columns: 1fr 1.1fr; align-items: center; }
    .telas { display: block; min-height: 420px; }
    .telas :global(.tela-desktop) { display: block; width: 100%; border-radius: 14px; border: 1px solid var(--grafite-2); box-shadow: 0 30px 60px rgba(0,0,0,.45); }
    .telas :global(.tela-celular) { position: absolute; right: -12px; bottom: -40px; width: 190px; max-height: 400px; border-width: 5px; border-radius: 24px; }
    .faixa { inset: 0; height: auto; transform: none; clip-path: polygon(42% 100%, 100% 52%, 100% 74%, 68% 100%); }
  }
</style>
