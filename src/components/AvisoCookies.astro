---
import { site } from '../content/site';
const c = site.cookies;
---
<div id="aviso-cookies" class="aviso" role="dialog" aria-live="polite" aria-label="Aviso de cookies" hidden>
  <p>{c.texto} <a href="/privacidade">Saiba mais</a></p>
  <div class="acoes">
    <button type="button" class="btn btn-contorno" data-consentimento="recusado">{c.recusar}</button>
    <button type="button" class="btn btn-escuro" data-consentimento="aceito">{c.aceitar}</button>
  </div>
</div>
<style>
  .aviso { position: fixed; left: 12px; right: 12px; bottom: 12px; z-index: 50; background: var(--branco); color: var(--grafite); border-radius: 20px; padding: 16px; box-shadow: 0 20px 40px rgba(0,0,0,.3); display: grid; gap: 12px; max-width: 560px; margin: 0 auto; }
  .aviso[hidden] { display: none; }
  .aviso p { font-size: 14.5px; }
  .aviso a { color: var(--laranja-texto); font-weight: 700; }
  .acoes { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
  .acoes .btn { min-height: 44px; padding: 10px; }
</style>
